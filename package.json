{
  "name": "cursor-language-pack",
  "private": true,
  "version": "1.1.2",
  "description": "Cursor 简体中文开源集成：界面语言包、原文切换与 Argos 本机翻译。Windows x64；适配 Cursor 3.27.6、3.27.12，其他版本需先核验。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "detect": "node scripts/detect-cursor.mjs",
    "extract": "node scripts/extract.mjs",
    "audit": "node scripts/audit-manifest.mjs",
    "gap": "node scripts/gap.mjs",
    "check-upgrade": "node scripts/check-upgrade.mjs",
    "test": "node scripts/run-tests.mjs",
    "sync": "node scripts/sync-upstream.mjs",
    "build": "node scripts/build.mjs",
    "coverage": "node scripts/coverage.mjs",
    "validate": "node scripts/validate-dist.mjs",
    "package": "node scripts/package.mjs",
    "translate": "node scripts/translate-install.mjs",
    "publish:ovsx": "node scripts/publish.mjs --registry=ovsx",
    "publish:vsce": "node scripts/publish.mjs --registry=vsce",
    "verify": "node scripts/verify.mjs",
    "clean": "node -e \"console.error('自动批量清理已禁用；需要清理时请由用户手动处理。');process.exit(1)\"",
    "test:offline": "node scripts/test-offline.mjs",
    "verify:all": "npm test && npm run verify",
    "check:repo": "node scripts/check-repository.mjs",
    "lint:md": "markdownlint-cli2",
    "test:protection": "python tests/offline-protection.test.py"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.1",
    "jsdom": "26.1.0",
    "markdownlint-cli2": "0.24.0",
    "opencc-js": "1.4.1",
    "ovsx": "0.10.1"
  },
  "$devDependencies": "opencc-js is only used by scripts/convert-zh-tw.mjs, which regenerates the zh-tw sources from zh-cn. It is declared so `npm ci` keeps it available.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Txk1001/cursor-zh-offline.git"
  },
  "homepage": "https://github.com/Txk1001/cursor-zh-offline#readme",
  "bugs": {
    "url": "https://github.com/Txk1001/cursor-zh-offline/issues"
  },
  "overrides": {
    "markdownlint-cli2": {
      "katex": "0.18.2"
    }
  }
}
