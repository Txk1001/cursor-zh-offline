{
  "config": {
    "MD013": false
  },
  "globs": [
    "*.md",
    "docs/**/*.md",
    "templates/**/*.md",
    ".github/**/*.md",
    "offline/*.md",
    "src/marketplace/*.md"
  ],
  "ignores": [
    "README-upstream.md",
    "node_modules/**",
    "upstream/**",
    "dist/**",
    "reports/**",
    "release/**"
  ]
}
